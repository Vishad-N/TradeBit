generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookStatus {
  PROCESSING
  READY
  FAILED
}

// NOT_SUBMITTED is derived (no row exists yet), so it is not stored.
enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum AccessStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AccessSource {
  TASK
  MENTORSHIP
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  // Collected at sign-up. Nullable because the admin account and older users have none.
  phone        String?
  passwordHash String
  role         Role     @default(USER)
  // Bumped to sign the user out everywhere: tokens carry the version they were issued with.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions    TaskSubmission[]
  accesses       ReadingAccess[]
  progress       ReadingProgress[]
  sessions       ReadingSession[]
  payments       MentorshipPayment[]
  mentorship     MentorshipAccess?
  lessonProgress LessonProgress[]
  enrollments    CourseEnrollment[]
}

model Book {
  id               String     @id @default(cuid())
  title            String
  description      String     @default("")
  // Private storage key of the original PDF. Never returned by any API.
  originalFilePath String
  pageCount        Int        @default(0)
  status           BookStatus @default(PROCESSING)
  processingError  String?
  isActive         Boolean    @default(true)
  /// Storage key of the optional cover image shown on the library card.
  coverKey         String?
  /// Only 1% Club members (an ACTIVE mentorship) and admins can read it. Tasks and free days never open it.
  clubOnly         Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  taskBooks TaskBook[]
  accesses  ReadingAccess[]
  progress  ReadingProgress[]
  sessions  ReadingSession[]
}

// A task shown to every user. One task can unlock several books (see TaskBook); submissions are per user.
model Task {
  id          String   @id @default(cuid())
  title       String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books       TaskBook[]
  submissions TaskSubmission[]

  @@index([isActive])
}

/// The books a task unlocks. Approving a user's submission grants access to every book linked here.
model TaskBook {
  taskId    String
  bookId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([taskId, bookId])
  @@index([bookId])
}

model TaskSubmission {
  id              String           @id @default(cuid())
  taskId          String
  userId          String
  status          SubmissionStatus @default(PENDING_REVIEW)
  rejectionReason String?
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@index([status])
}

model ReadingAccess {
  id        String       @id @default(cuid())
  userId    String
  bookId    String
  status    AccessStatus @default(ACTIVE)
  grantedAt DateTime     @default(now())
  expiresAt DateTime?
  // Why this access exists: "TASK" (approved reading task) or "MENTORSHIP" (approved 1:1 payment).
  // Withdrawing a mentorship only revokes rows it created.
  source    AccessSource @default(TASK)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model ReadingProgress {
  id                 String   @id @default(cuid())
  userId             String
  bookId             String
  currentPage        Int      @default(1)
  progressPercentage Int      @default(0)
  lastReadAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

// One live reading session per user+book; opening the reader elsewhere replaces it.
model ReadingSession {
  id         String   @id @default(cuid())
  userId     String
  bookId     String
  token      String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

// Manual USDT (TRC20) payment submitted by a user for 1:1 mentorship. There is no automatic verification:
// an admin reviews the transaction hash + screenshot and approves or rejects.
model MentorshipPayment {
  id              String        @id @default(cuid())
  userId          String
  amountPaid      Decimal       @db.Decimal(18, 6)
  network         String        @default("TRC20")
  // One transaction can only ever back one submission.
  txHash          String        @unique
  paymentDate     DateTime
  // Private storage key of the screenshot. Never returned by any API.
  screenshotKey   String
  status          PaymentStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime      @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model MentorshipAccess {
  id        String       @id @default(cuid())
  userId    String       @unique
  status    AccessStatus @default(ACTIVE)
  grantedAt DateTime     @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A trading platform / broker / partner shown on the landing page. The "Sign up" button goes through
// /go/:slug, which redirects to the platform's own referral URL (stored exactly as the client supplied it).
model Platform {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String    @default("")
  category     String?
  // Logo: either an https image URL, or an uploaded file kept in storage and served at /platforms/:slug/logo.
  logoUrl      String?
  logoKey      String?
  // The official referral / affiliate URL. Never rebuilt or altered by the app.
  referralUrl  String?
  // Some platforms only give a code. It is shown with a copy button; a code can NOT be auto-filled on another site.
  referralCode String?
  // Normal registration page, used when there is only a referral code and no referral URL.
  websiteUrl   String?
  ctaLabel     String?
  featured     Boolean   @default(false)
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  clicks       Int       @default(0)
  lastClickAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

/// Sign-ups from the /tt-1 webinar page (popup and on-page form). Shown in Admin -> Webinar Registrations.
model WebinarRegistration {
  id        String   @id @default(cuid())
  name      String
  email     String
  /// International format, e.g. +919876543210
  phone     String
  /// ISO country code picked in the form (popup only)
  country   String?
  /// "popup" or "page"
  source    String   @default("page")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

/// Student stories shown in the landing page's "Student Stories" section (Admin -> Testimonials).
/// kind TEXT = written review, VIDEO = video testimonial (videoUrl is a YouTube / Vimeo / .mp4 https link).
model Testimonial {
  id        String   @id @default(cuid())
  kind      String   @default("TEXT")
  quote     String   @default("")
  name      String
  role      String   @default("")
  rating    Int      @default(5)
  videoUrl  String?
  duration  String?
  /// Optional avatar, stored in storage and served at /testimonials/:id/photo
  photoKey  String?
  /// Or a static site file such as /reviews/prince-pal.webp (used by the seeded reviews). photoKey wins when both are set.
  photoUrl  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive, sortOrder])
}

/// Profit screenshots in the looping strip above the landing page footer (Admin -> Profit Screenshots).
/// The image file lives in storage under imageKey and is served at /profit-shots/:id/image.
model ProfitShot {
  id        String   @id @default(cuid())
  imageKey  String
  caption   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Photos in the Gallery page's glass carousel (Admin -> Gallery). The file lives in storage under imageKey
/// and is served at /gallery/:id/image. Until MIN images exist the site tops up with built-in sample photos.
model GalleryImage {
  id        String   @id @default(cuid())
  imageKey  String
  caption   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Social / community links editable in Admin -> Social Links. One row per key (telegram, instagram, ...).
/// A missing row means "use the site's built-in default link"; an empty url is never stored.
model SiteLink {
  key       String   @id
  url       String
  updatedAt DateTime @updatedAt
}

/// Admin-configurable price (and optional timed offer) for a product: invitation (the course) or club (1% Club).
model ProductPricing {
  product       String    @id
  listPrice     Decimal   @db.Decimal(12, 2)
  price         Decimal   @db.Decimal(12, 2)
  offerEnabled  Boolean   @default(false)
  offerPrice    Decimal?  @db.Decimal(12, 2)
  offerTitle    String?
  offerStartsAt DateTime?
  offerEndsAt   DateTime?
  updatedAt     DateTime  @updatedAt
}

/// The recurring "free reading" schedule (one row, id "default"): on the chosen weekdays the chosen books open for every
/// logged-in user with no task. Club-only books are never included.
model FreeReadingSchedule {
  id          String   @id
  enabled     Boolean  @default(false)
  /// Weekdays 0 = Sunday ... 6 = Saturday.
  days        Int[]
  /// Minutes after midnight in `timezone`; the window is [startMinute, endMinute). 0 and 1440 = all day.
  startMinute Int      @default(0)
  endMinute   Int      @default(1440)
  timezone    String   @default("Asia/Kolkata")
  /// true = every non-club book, false = only `bookIds`.
  allBooks    Boolean  @default(true)
  bookIds     String[]
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------- Courses (Vimeo video lessons)
// Who may open a course's lessons. Any lesson can additionally be a free preview.
enum CourseAccess {
  PUBLIC // any logged-in user
  CLUB // 1% Club members (ACTIVE mentorship) and explicitly enrolled users
  ENROLLED // only users an admin enrolled
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  summary     String       @default("")
  description String       @default("")
  /// Storage key of the optional thumbnail.
  thumbKey    String?
  access      CourseAccess @default(PUBLIC)
  published   Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modules     CourseModule[]
  enrollments CourseEnrollment[]

  @@index([published, sortOrder])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, sortOrder])
}

model Lesson {
  id            String   @id @default(cuid())
  moduleId      String
  title         String
  description   String   @default("")
  /// Only the Vimeo video id (digits). Never returned to a viewer who may not watch the lesson.
  vimeoId       String?
  /// Privacy hash of an unlisted Vimeo video (the "h" in player.vimeo.com/video/ID?h=HASH).
  vimeoHash     String?
  durationSec   Int      @default(0)
  isFreePreview Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([moduleId, sortOrder])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  /// Where the viewer stopped (resume point), in seconds.
  positionSec Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model CourseEnrollment {
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@index([courseId])
}
