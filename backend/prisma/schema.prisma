generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookStatus {
  PROCESSING
  READY
  FAILED
}

// NOT_SUBMITTED is derived (no row exists yet), so it is not stored.
enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum AccessStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  // Collected at sign-up. Nullable because the admin account and older users have none.
  phone        String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions TaskSubmission[]
  accesses    ReadingAccess[]
  progress    ReadingProgress[]
  sessions    ReadingSession[]
  payments    MentorshipPayment[]
  mentorship  MentorshipAccess?
}

model Book {
  id               String     @id @default(cuid())
  title            String
  description      String     @default("")
  // Private storage key of the original PDF. Never returned by any API.
  originalFilePath String
  pageCount        Int        @default(0)
  status           BookStatus @default(PROCESSING)
  processingError  String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tasks    Task[]
  accesses ReadingAccess[]
  progress ReadingProgress[]
  sessions ReadingSession[]
}

// One global task shared by every user. Submissions are per user.
model Task {
  id          String   @id @default(cuid())
  bookId      String
  title       String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  book        Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  submissions TaskSubmission[]

  @@index([isActive])
  @@index([bookId])
}

model TaskSubmission {
  id              String           @id @default(cuid())
  taskId          String
  userId          String
  status          SubmissionStatus @default(PENDING_REVIEW)
  rejectionReason String?
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@index([status])
}

model ReadingAccess {
  id        String       @id @default(cuid())
  userId    String
  bookId    String
  status    AccessStatus @default(ACTIVE)
  grantedAt DateTime     @default(now())
  expiresAt DateTime?
  // Why this access exists: "TASK" (approved reading task) or "MENTORSHIP" (approved 1:1 payment).
  // Withdrawing a mentorship only revokes rows it created.
  source    String       @default("TASK")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model ReadingProgress {
  id                 String   @id @default(cuid())
  userId             String
  bookId             String
  currentPage        Int      @default(1)
  progressPercentage Int      @default(0)
  lastReadAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

// One live reading session per user+book; opening the reader elsewhere replaces it.
model ReadingSession {
  id         String   @id @default(cuid())
  userId     String
  bookId     String
  token      String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

// Manual USDT (TRC20) payment submitted by a user for 1:1 mentorship. There is no automatic verification:
// an admin reviews the transaction hash + screenshot and approves or rejects.
model MentorshipPayment {
  id              String        @id @default(cuid())
  userId          String
  amountPaid      Decimal       @db.Decimal(18, 6)
  network         String        @default("TRC20")
  // One transaction can only ever back one submission.
  txHash          String        @unique
  paymentDate     DateTime
  // Private storage key of the screenshot. Never returned by any API.
  screenshotKey   String
  status          PaymentStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime      @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model MentorshipAccess {
  id        String       @id @default(cuid())
  userId    String       @unique
  status    AccessStatus @default(ACTIVE)
  grantedAt DateTime     @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A trading platform / broker / partner shown on the landing page. The "Sign up" button goes through
// /go/:slug, which redirects to the platform's own referral URL (stored exactly as the client supplied it).
model Platform {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String    @default("")
  category     String?
  // Logo: either an https image URL, or an uploaded file kept in storage and served at /platforms/:slug/logo.
  logoUrl      String?
  logoKey      String?
  // The official referral / affiliate URL. Never rebuilt or altered by the app.
  referralUrl  String?
  // Some platforms only give a code. It is shown with a copy button; a code can NOT be auto-filled on another site.
  referralCode String?
  // Normal registration page, used when there is only a referral code and no referral URL.
  websiteUrl   String?
  ctaLabel     String?
  featured     Boolean   @default(false)
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  clicks       Int       @default(0)
  lastClickAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

/// Sign-ups from the /tt-1 webinar page (popup and on-page form). Shown in Admin -> Webinar Registrations.
model WebinarRegistration {
  id        String   @id @default(cuid())
  name      String
  email     String
  /// International format, e.g. +919876543210
  phone     String
  /// ISO country code picked in the form (popup only)
  country   String?
  /// "popup" or "page"
  source    String   @default("page")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}
