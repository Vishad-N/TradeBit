# --- Core ---
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postvishad@localhost:5432/tradebit_reading?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:5173

# --- First admin (created/updated on boot when both are set) ---
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

# --- File storage: the first one configured wins (Cloudinary > S3 bucket > local folder) ---
# Option A: Cloudinary. Use EITHER the single URL (copy it from the Cloudinary dashboard) OR the three values.
# Files are uploaded as type "authenticated" (no public URLs); the API proxies every page after its own checks.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option B: private S3-compatible bucket (e.g. a Railway Bucket).
# If neither A nor B is set the API falls back to the local ./storage folder (dev only).
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Set true for providers that need path-style URLs (many S3-compatible stores)
STORAGE_FORCE_PATH_STYLE=true
STORAGE_LOCAL_DIR=./storage

# --- Reading ---
# Cloudinary free plans cap raw files at ~10MB; set MAX_PDF_MB to match your plan's limit.
MAX_PDF_MB=50
# Pixel scale used when rendering PDF pages (1 = 72dpi). 1.8 is a good reading quality.
PAGE_RENDER_SCALE=1.8
PAGE_JPEG_QUALITY=82
# Days an approval stays valid; empty = no expiry
READING_ACCESS_DAYS=

# --- 1:1 mentorship payments (manual USDT / TRC20) ---
# Shown to logged-in users on the payment page. The wallet must be a TRON (T...) address.
MENTORSHIP_PRICE_USDT=
MENTORSHIP_WALLET_ADDRESS=
# Sent ONLY to users whose payment was approved (e.g. https://t.me/your_username)
TELEGRAM_URL=
# Payment submissions allowed per user per minute (anti-abuse)
PAYMENT_RATE_LIMIT_PER_MIN=6

# LOCAL TESTING ONLY: lets you skip the payment step on the mentorship page. Ignored when NODE_ENV=production.
MENTORSHIP_TEST_MODE=false
